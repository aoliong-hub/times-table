.result {
  padding: 60rpx 40rpx;
  text-align: center;
}

.badge {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border: 5rpx solid;
  border-radius: 50%;
  font-size: 84rpx;
  line-height: 160rpx;
}

.stars {
  margin-top: 26rpx;
  font-size: 60rpx;
  color: var(--energy-gold);
  letter-spacing: 10rpx;
}

.word {
  margin-top: 14rpx;
  font-size: 34rpx;
  color: var(--text-light);
}

.score {
  margin-top: 40rpx;
  padding: 34rpx 0;
}

.score-num {
  font-size: 96rpx;
  font-weight: bold;
  color: var(--energy-gold);
  line-height: 1.1;
}

.score-max {
  font-size: 26rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.score-new {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--energy-green);
}

.stats {
  margin-top: 28rpx;
  padding: 28rpx 0;
  display: flex;
}

.stat {
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.actions {
  margin-top: 50rpx;
}

.act {
  padding: 26rpx 0;
  font-size: 32rpx;
  margin-bottom: 22rpx;
}
